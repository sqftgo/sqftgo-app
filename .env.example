# Required for live auth + data (Supabase via Next.js BFF).
# When unset, the app falls back to offline AsyncStorage mock data.
# Next.js origin that serves /api/* (no trailing slash)
EXPO_PUBLIC_API_URL=https://www.sqftgo.com

# Local web BFF (optional):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project used for post-login mobile OTP and service-provider access checks.
# The key is the publishable client key, never the service role key.
# MSG91 / WhatsApp OTP credentials for sign-up and sign-in live only on the BFF
# (Next.js) and Supabase edge — do not put them in the Expo app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key
