# Required for live auth + data (Supabase via Next.js BFF).
# When unset, the app falls back to offline AsyncStorage mock data.
# Next.js origin that serves /api/* (no trailing slash)
EXPO_PUBLIC_API_URL=https://www.sqftgo.com

# Local web BFF (optional):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In is pending — see docs/GOOGLE_SIGNIN_PENDING.md
# (will need EXPO_PUBLIC_SUPABASE_* and EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID later)
